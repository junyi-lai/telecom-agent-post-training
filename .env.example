# Student policy and model cache
STUDENT_MODEL=Qwen/Qwen3.5-2B
STUDENT_MODEL_REVISION=15852e8c16360a2fea060d615a32b45270f8a8fc
STUDENT_MODEL_PATH=./models/Qwen3.5-2B
HF_HOME=./tmp/cache/huggingface
PROFILE_FILE=./configs/profiles/96gb.env

# DeepSeek is used in two independent roles. HTTPS is required for public
# endpoints; plain HTTP requires the explicit opt-in below.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ALLOW_INSECURE_DEEPSEEK_HTTP=0
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional deployment alias; leave empty to use DEEPSEEK_MODEL in requests.
DEEPSEEK_REQUEST_MODEL=
# Configure both fields only when a distinct fallback route is available.
DEEPSEEK_FALLBACK_BASE_URL=
DEEPSEEK_FALLBACK_API_KEY=
DEEPSEEK_FALLBACK_MODEL=deepseek-flash
DEEPSEEK_TEACHER_MODEL=deepseek-flash
DEEPSEEK_MAX_CONCURRENCY=2
DEEPSEEK_MIN_CONCURRENCY=1
DEEPSEEK_GLOBAL_MAX_CONCURRENCY=32
DEEPSEEK_FALLBACK_MAX_CONCURRENCY=4
DEEPSEEK_FALLBACK_MIN_CONCURRENCY=2
DEEPSEEK_FALLBACK_GLOBAL_MAX_CONCURRENCY=4
DEEPSEEK_FALLBACK_FUSE_SECONDS=3600
# Optional paths. Defaults are under /tmp and are not written to Git.
# DEEPSEEK_FALLBACK_FUSE_PATH=/tmp/telecom_post_training_deepseek_fallback.fused
# DEEPSEEK_GATE_DIR=/tmp/telecom_post_training_deepseek_slots
DEEPSEEK_ADAPTIVE_CONCURRENCY=1
DEEPSEEK_ADAPTIVE_COOLDOWN_SECONDS=2
DEEPSEEK_SUCCESSES_TO_RAMP=8
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_RETRIES=5
DEEPSEEK_RETRY_BASE_SECONDS=0.1
DEEPSEEK_RETRY_JITTER_RATIO=0.25
DEEPSEEK_RETRY_MAX_SECONDS=1
DEEPSEEK_TOTAL_REQUEST_DEADLINE_SECONDS=60
DEEPSEEK_TELEMETRY_PATH=./tmp/artifacts/logs/deepseek_client.jsonl
DEEPSEEK_USER_TEMPERATURE=0.7
DEEPSEEK_TEACHER_TEMPERATURE=0.2
DEEPSEEK_USER_SEED=42
DEEPSEEK_TEACHER_SEED=43

# Optional profile overrides. Command-line environment values are preserved.
# SFT_MICRO_BATCH_SIZE=4
# SFT_MAX_TOKEN_LEN_PER_GPU=65536
# GRPO_MICRO_BATCH_SIZE=2
# GRPO_LOGPROB_MICRO_BATCH_SIZE=2
# GRPO_VLLM_GPU_MEMORY_UTILIZATION=0.50
# GRPO_VLLM_MAX_NUM_SEQS=128
# AGENT_WORKERS=16
# DEEPSEEK_MAX_CONCURRENCY=16

# Benchmark environment
TAU2_REPO=./third_party/tau2-bench
TAU2_DOMAIN=telecom
TAU2_COMMIT=19f13ea3f5fba8b4c4d272d1353590f29dc53062
TAU2_ROLLOUT_MAX_TURNS=30
TAU2_TEACHER_MAX_STEPS=60
TAU2_ROLLOUT_CONTEXT_TOKENS=32768
TAU2_ROLLOUT_CONCURRENCY=8
TAU2_MAX_TOKENS_PER_TURN=256
LOGURU_LEVEL=WARNING

# Student inference service
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
VLLM_MODEL_ALIAS=student
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.72
VLLM_MAX_NUM_SEQS=8
VLLM_TOOL_CALL_PARSER=qwen3_coder
VLLM_REASONING_PARSER=qwen3
