# 96 GB GPU profile. Values are defaults; exported environment variables win.
: "${PROFILE_NAME:=96gb-fast}"
: "${GPU_MEMORY_GB:=96}"

: "${SFT_TRAIN_BATCH_SIZE:=8}"
: "${SFT_MICRO_BATCH_SIZE:=4}"
: "${SFT_MAX_TOKEN_LEN_PER_GPU:=65536}"
: "${SFT_MAX_LENGTH:=32768}"

: "${GRPO_TRAIN_BATCH_SIZE:=8}"
: "${GRPO_GROUP_SIZE:=8}"
: "${GRPO_STEPS:=75}"
: "${GRPO_MINI_BATCH_SIZE:=8}"
: "${GRPO_MICRO_BATCH_SIZE:=4}"
: "${GRPO_LOGPROB_MICRO_BATCH_SIZE:=4}"
: "${GRPO_PARAM_OFFLOAD:=0}"
: "${GRPO_OPTIMIZER_OFFLOAD:=0}"
: "${GRPO_VLLM_GPU_MEMORY_UTILIZATION:=0.50}"
: "${GRPO_VLLM_MAX_NUM_SEQS:=128}"
: "${AGENT_WORKERS:=16}"
: "${GRPO_MAX_INFLIGHT_GEN_BATCHES:=1}"
: "${TAU2_MAX_ACTIVE_ROLLOUTS_PER_WORKER:=2}"

: "${DEEPSEEK_MAX_CONCURRENCY:=2}"
: "${DEEPSEEK_MIN_CONCURRENCY:=1}"
: "${DEEPSEEK_GLOBAL_MAX_CONCURRENCY:=32}"
: "${DEEPSEEK_FALLBACK_MAX_CONCURRENCY:=4}"
: "${DEEPSEEK_FALLBACK_MIN_CONCURRENCY:=2}"
: "${DEEPSEEK_FALLBACK_GLOBAL_MAX_CONCURRENCY:=4}"
: "${DEEPSEEK_FALLBACK_FUSE_SECONDS:=3600}"
: "${SKIP_SMOKE_VERIFICATION:=0}"
: "${DEEPSEEK_ADAPTIVE_CONCURRENCY:=1}"
: "${DEEPSEEK_ADAPTIVE_COOLDOWN_SECONDS:=2}"
: "${DEEPSEEK_SUCCESSES_TO_RAMP:=8}"
: "${DEEPSEEK_REQUEST_TIMEOUT_SECONDS:=20}"
: "${DEEPSEEK_MAX_RETRIES:=5}"
: "${DEEPSEEK_RETRY_BASE_SECONDS:=0.1}"
: "${DEEPSEEK_RETRY_JITTER_RATIO:=0.25}"
: "${DEEPSEEK_RETRY_MAX_SECONDS:=1}"
: "${DEEPSEEK_TOTAL_REQUEST_DEADLINE_SECONDS:=60}"
: "${DEEPSEEK_BASE_URL:=http://127.0.0.1:18083}"
: "${DEEPSEEK_MODEL:=deepseek-flash}"
: "${DEEPSEEK_FALLBACK_BASE_URL:=https://api.deepseek.com/v1}"
: "${DEEPSEEK_FALLBACK_MODEL:=deepseek-flash}"
: "${ALLOW_INSECURE_DEEPSEEK_HTTP:=0}"
: "${LOGURU_LEVEL:=WARNING}"

export PROFILE_NAME GPU_MEMORY_GB
export SFT_TRAIN_BATCH_SIZE SFT_MICRO_BATCH_SIZE
export SFT_MAX_TOKEN_LEN_PER_GPU SFT_MAX_LENGTH
export GRPO_TRAIN_BATCH_SIZE GRPO_GROUP_SIZE GRPO_STEPS
export GRPO_MINI_BATCH_SIZE GRPO_MICRO_BATCH_SIZE
export GRPO_LOGPROB_MICRO_BATCH_SIZE
export GRPO_PARAM_OFFLOAD GRPO_OPTIMIZER_OFFLOAD
export GRPO_VLLM_GPU_MEMORY_UTILIZATION GRPO_VLLM_MAX_NUM_SEQS
export AGENT_WORKERS
export GRPO_MAX_INFLIGHT_GEN_BATCHES
export TAU2_MAX_ACTIVE_ROLLOUTS_PER_WORKER
export DEEPSEEK_MAX_CONCURRENCY DEEPSEEK_MIN_CONCURRENCY
export DEEPSEEK_GLOBAL_MAX_CONCURRENCY
export DEEPSEEK_FALLBACK_MAX_CONCURRENCY DEEPSEEK_FALLBACK_MIN_CONCURRENCY
export DEEPSEEK_FALLBACK_GLOBAL_MAX_CONCURRENCY DEEPSEEK_FALLBACK_FUSE_SECONDS
export SKIP_SMOKE_VERIFICATION
export DEEPSEEK_ADAPTIVE_CONCURRENCY DEEPSEEK_ADAPTIVE_COOLDOWN_SECONDS
export DEEPSEEK_SUCCESSES_TO_RAMP DEEPSEEK_REQUEST_TIMEOUT_SECONDS
export DEEPSEEK_MAX_RETRIES DEEPSEEK_RETRY_BASE_SECONDS
export DEEPSEEK_RETRY_JITTER_RATIO DEEPSEEK_RETRY_MAX_SECONDS
export DEEPSEEK_TOTAL_REQUEST_DEADLINE_SECONDS
export DEEPSEEK_BASE_URL DEEPSEEK_MODEL
export DEEPSEEK_FALLBACK_BASE_URL DEEPSEEK_FALLBACK_MODEL
export ALLOW_INSECURE_DEEPSEEK_HTTP
export LOGURU_LEVEL
